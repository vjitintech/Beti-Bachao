# Copy to .env (never commit real values)
PORT=8080
DEMO_MODE=false            # true = seeded synthetic data + /api/v1/demo/* routes
MFA_REQUIRED=true          # TOTP for operator/admin
COOKIE_SECURE=true         # set true behind HTTPS
TRUST_PROXY=false          # true only behind a trusted reverse proxy (X-Forwarded-For)
DATA_FILE=./data/db.json
ADMIN_EMAIL=               # first-boot admin (production)
ADMIN_PASSWORD=
