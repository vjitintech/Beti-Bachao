# Copy to .env for local runs (never commit real values)
PORT=8080
DATA_FILE=./data/db.json      # put this on a persistent disk in production
ADMIN_EMAIL=you@example.org   # first admin, created on first start
ADMIN_PASSWORD=               # 12+ characters
COOKIE_SECURE=true            # true when served over HTTPS (production)
TRUST_PROXY=true              # true behind Render/NGINX etc. (for rate limiting by real IP)
MFA_REQUIRED=true             # authenticator app for operators/admins
# Optional: fixed Web Push keys (otherwise generated once and saved in the data file)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org
